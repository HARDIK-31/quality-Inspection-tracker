# Copy to `.env` for local (non-Docker) development.
# docker-compose supplies these itself.

NODE_ENV=development
PORT=4000

# Use `localhost` on the host, or `postgres` inside Docker.
DATABASE_URL="postgresql://qit:qit_ard@localhost:5432/qit?schema=public"

# Comma-separated allowlist, or * for any origin.
CORS_ORIGIN=*

JWT_SECRET=a9e3feaf15997f1c948d0f240a2382589a59aa98a0a6e262395feff3b11f8d36
JWT_EXPIRES_IN=12h

# Shared secret the SAP webhook expects in the x-sap-signature header.
SAP_WEBHOOK_SECRET=x-arvind-001-dhrq24sd3-sap
